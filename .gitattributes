# Satir sonlari: depoda LF kalsin (Windows'ta CRLF donusumu karisiklik yaratmasin)
* text=auto eol=lf

# Ikili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.zip binary
*.gz binary
*.pyz binary
*.pkg binary

# Windows betikleri CRLF ile calisir
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
